# Copy to .env and fill in. Never commit .env, and never put a private key in this file:
# import the key once with `cast wallet import exitguard --interactive` and pass `--account exitguard`.

# RPC of the chain the vault lives on, and of Reactive Lasna (replace with your own provider if rate limited)
export VAULT_RPC=https://ethereum-sepolia-rpc.publicnode.com      # Ethereum Sepolia
# export VAULT_RPC=https://sepolia.base.org                       # Base Sepolia
export LASNA_RPC=https://lasna-rpc.rnk.dev/

# The other chain of the cross-chain trigger (steps 8 to 10): where the demo protocol's sister deployment lives
export SISTER_RPC=https://sepolia.base.org                        # Base Sepolia
# export SISTER_RPC=https://ethereum-sepolia-rpc.publicnode.com   # Ethereum Sepolia, when the vault is on Base Sepolia

# Reactive's faucet contract on the vault chain: send test ETH, receive test REACT on Lasna (1 : 100)
export REACT_FAUCET=0x9b9BB25f1A81078C544C829c5EB7822d747Cf434    # on Ethereum Sepolia
# export REACT_FAUCET=0x2afaFD298b23b62760711756088F75B7409f5967  # on Base Sepolia

# Address of the throwaway testnet wallet you imported
export YOU=0xYourTestnetWalletAddress

# Optional overrides
# export TIMELOCK_DELAY=120                     # seconds between queueing and executing the demo upgrade
# export REACTIVE_FUNDING=500000000000000000    # wei of lREACT sent to the reactive contract (default 0.5)
# export GUARD_FUNDING=5000000000000000         # wei of ETH sent to the guard for callbacks (default 0.005)
# export CALLBACK_PROXY=0x...                   # only for chains not built into script/utils/Deployments.sol
