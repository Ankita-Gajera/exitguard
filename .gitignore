# Foundry build output
out/
cache/
broadcast/

# Dependencies, fetched with `forge install --no-git ...` (see README)
lib/

# Secrets: never commit keys or RPC URLs with API tokens
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.idea/
.vscode/

# Addresses written by the scripts during a run (kept out of git until a deployment is final)
deployments/*.json
